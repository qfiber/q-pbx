<!DOCTYPE html>
<html lang={assigns[:locale] || "en"} dir={QPBX.Web.Locale.dir(assigns[:locale])}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Q-PBX" suffix=" · Q-PBX">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo-mark.svg"} />
    <link rel="icon" sizes="16x16 32x32 48x48" href={~p"/favicon.ico"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script src={~p"/theme.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
