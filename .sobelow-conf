# Sobelow security scan (CI fails on any finding). Skipped findings carry their reason next to
# a "sobelow_skip" comment in the code.
[
  verbose: false,
  private: false,
  skip: true,
  router: "lib/qpbx/web/router.ex",
  exit: "low",
  format: "txt",
  out: nil,
  # The CSP comes from the QPBX.Web.CSP plug (it depends on the configured human-check
  # provider), which Sobelow does not recognise; test/qpbx/web/csp_test.exs checks it.
  # Config.CSWH: the API event stream (/v1/socket) accepts any origin on purpose: it uses no
  # cookies, the key is in a handshake header (see lib/qpbx/web/endpoint.ex). The portal's
  # /live socket keeps its origin check; test/qpbx/web/api/event_channel_test.exs guards that.
  ignore: ["Config.CSP", "Config.CSWH"],
  ignore_files: []
]
