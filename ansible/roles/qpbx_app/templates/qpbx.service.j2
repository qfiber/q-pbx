# {{ ansible_managed }}
[Unit]
Description=Q-PBX control plane
After=network-online.target postgresql.service qpbx-fwd.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=qpbx
Group=qpbx
EnvironmentFile=/etc/qpbx/qpbx.env
Environment=HOME={{ qpbx_data_dir }} RELEASE_TMP=/run/qpbx LANG=C.UTF-8
# Temporary data (uploads, conversions) only in memory, readable by this service alone.
Environment=TMPDIR=/run/qpbx/tmp PLUG_TMPDIR=/run/qpbx/tmp
ExecStartPre=/opt/qpbx/bin/qpbx eval QPBX.Release.migrate
ExecStart=/opt/qpbx/bin/qpbx start
ExecStop=/opt/qpbx/bin/qpbx stop
RuntimeDirectory=qpbx qpbx/tmp
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# No capabilities at all (nginx binds 80/443). MemoryDenyWriteExecute stays off: it breaks the BEAM JIT.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{ qpbx_data_dir }} /run/qpbx-media
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
