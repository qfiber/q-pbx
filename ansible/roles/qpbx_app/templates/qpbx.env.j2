# {{ ansible_managed }}
PHX_HOST={{ qpbx_portal_host }}
DATABASE_URL=ecto://qpbx:{{ qpbx_secrets.db_password }}@localhost/qpbx
SECRET_KEY_BASE={{ qpbx_secrets.secret_key_base }}
QPBX_CLOAK_KEY={{ qpbx_secrets.cloak_key }}
RELEASE_COOKIE={{ qpbx_secrets.release_cookie }}
QPBX_SIP_BASE_DOMAIN={{ qpbx_domain }}
QPBX_HEALTH_TOKEN={{ qpbx_secrets.health_token }}
QPBX_HEALTH_DISK_PATHS="/ {{ qpbx_data_dir }}"
QPBX_TLS_CERT_FILE={{ qpbx_tls_dir }}/fullchain.pem
PORT=4000
QPBX_FS_ESL_HOST=127.0.0.1
QPBX_FS_ESL_PORT=8021
QPBX_KAMAILIO_JSONRPC_URL=http://127.0.0.1:5071/RPC
QPBX_FWD_SOCKET=/run/qpbx-fwd/fwd.sock
QPBX_CAPTCHA_PROVIDER={{ qpbx_captcha_provider }}
QPBX_CAPTCHA_SITE_KEY={{ qpbx_captcha_site_key }}
QPBX_CAPTCHA_SECRET={{ qpbx_captcha_secret }}
QPBX_MAIL_FROM={{ qpbx_mail_from }}
QPBX_SMTP_HOST={{ qpbx_smtp_host }}
QPBX_SMTP_PORT={{ qpbx_smtp_port }}
{% if qpbx_smtp_username %}
QPBX_SMTP_USERNAME={{ qpbx_smtp_username }}
QPBX_SMTP_PASSWORD={{ qpbx_smtp_password }}
{% endif %}
