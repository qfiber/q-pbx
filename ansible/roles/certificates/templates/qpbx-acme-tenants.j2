#!/bin/sh
# {{ ansible_managed }}
# Issues a certificate for every tenant SIP domain listed in $1 that does not have one yet
# (HTTP-01). Runs as qpbx-acme. Certificates land in {{ qpbx_tls_dir }}/tenants/<domain>/;
# Kamailio uses them by SNI (phase 2).
set -eu
umask 027
while read -r domain; do
  case $domain in *[!a-z0-9.-]*|'') continue ;; esac
  dir={{ qpbx_tls_dir }}/tenants/$domain
  [ -s "$dir/fullchain.pem" ] && continue
  mkdir -p "$dir"
  # Exit code 2 means "already issued, not due": install that certificate too.
  rc=0
  /usr/local/sbin/qpbx-acme --issue -w {{ certificates_webroot }} -d "$domain" --keylength ec-256 || rc=$?
  if [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]; then
    /usr/local/sbin/qpbx-acme --install-cert -d "$domain" --ecc --fullchain-file "$dir/fullchain.pem" \
      --key-file "$dir/privkey.pem" \
      --reloadcmd "touch {{ qpbx_tls_dir }}/tenants/.updated"  || echo "installing $domain failed; will retry" >&2
    # acme.sh writes keys 0600; Kamailio reads them through the qpbx-tls group.
    chmod 0640 "$dir"/*.pem 2>/dev/null || true
  else
    echo "certificate for $domain failed; will retry" >&2
  fi
done < "$1"
