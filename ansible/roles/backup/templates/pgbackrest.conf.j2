# {{ ansible_managed }}
[global]
repo1-type=sftp
repo1-path=/data/{{ qpbx_backup_name }}/pgbackrest
repo1-sftp-host={{ qpbx_backup_host }}
repo1-sftp-host-port={{ qpbx_backup_port }}
repo1-sftp-host-user={{ qpbx_backup_user }}
repo1-sftp-private-key-file=/etc/qpbx-backup/id_ed25519
repo1-sftp-public-key-file=/etc/qpbx-backup/id_ed25519.pub
repo1-sftp-host-key-check-type=strict
repo1-sftp-host-key-hash-type=sha256
repo1-sftp-known-host=/etc/qpbx-backup/known_hosts
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass={{ qpbx_secrets.pgbackrest_cipher }}
repo1-retention-full={{ qpbx_backup_keep_full }}
compress-type=zst
start-fast=y
log-level-console=info
log-level-file=off

[qpbx]
pg1-path=/var/lib/postgresql/16/main
