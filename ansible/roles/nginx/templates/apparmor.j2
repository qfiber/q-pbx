# {{ ansible_managed }}
# Complain mode during lab phases; enforced in phase 4. nginx runs nothing else.
abi <abi/3.0>,
include <tunables/global>

profile qpbx-nginx /usr/sbin/nginx flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/openssl>
  capability net_bind_service,
  capability setuid,
  capability setgid,
  network inet,
  network inet6,
  network unix,
  /usr/sbin/nginx mr,
  /usr/lib/nginx/modules/*.so mr,
  /usr/lib/x86_64-linux-gnu/** mr,
  /etc/nginx/** r,
  /etc/modsecurity/** r,
  /usr/share/modsecurity-crs/** r,
  {{ qpbx_tls_dir }}/*.pem r,
  {{ qpbx_data_dir }}/acme/** r,
  /var/log/nginx/** rw,
  /var/lib/nginx/** rwk,
  /run/nginx/** rwk,
  @{PROC}/** r,
  /sys/devices/system/cpu/** r,
}
