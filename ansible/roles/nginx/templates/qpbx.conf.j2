# {{ ansible_managed }}

{% if qpbx_cdn != 'none' %}
# Real client IP: only {{ qpbx_cdn }} may set {{ nginx_cdn_header }}.
{% for net in nginx_cdn_ranges %}
set_real_ip_from {{ net }};
{% endfor %}
real_ip_header {{ nginx_cdn_header }};
real_ip_recursive on;
{% endif %}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;

  location /.well-known/acme-challenge/ {
    root {{ qpbx_data_dir }}/acme;
    default_type text/plain;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name _;

  ssl_certificate {{ qpbx_tls_dir }}/fullchain.pem;
  ssl_certificate_key {{ qpbx_tls_dir }}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=63072000" always;
  client_max_body_size {{ qpbx_nginx_max_body }};

{% if qpbx_nginx_modsecurity %}
  modsecurity on;
  modsecurity_rules_file /etc/nginx/qpbx-modsecurity.conf;
{% endif %}
  # Operator additions (rate limits, IP rules, extra headers).
  include /etc/nginx/qpbx.d/*.conf;

  location / {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite, never append: the app trusts X-Real-IP from localhost only.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # LiveView keeps a WebSocket open.
    proxy_read_timeout 3600s;
  }
}
