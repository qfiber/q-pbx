# {{ ansible_managed }}
[Unit]
Description=FreeSWITCH (Q-PBX media)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=freeswitch
Group=freeswitch
ExecStart=/opt/qpbx-freeswitch/bin/freeswitch -nonat -nf -nc -conf /etc/freeswitch -log /var/log/freeswitch -db /var/lib/freeswitch/db -run /run/freeswitch -storage /var/lib/freeswitch/storage -recordings {{ qpbx_data_dir }}/recordings
RuntimeDirectory=freeswitch
Restart=on-failure
RestartSec=5
LimitNOFILE=100000
LimitRTPRIO=infinity
IOSchedulingClass=realtime
CPUSchedulingPolicy=rr
CPUSchedulingPriority=89

AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_NICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/freeswitch /var/log/freeswitch {{ qpbx_data_dir }}/recordings {{ qpbx_data_dir }}/faxes {{ qpbx_data_dir }}/voicemail /run/qpbx-media
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
