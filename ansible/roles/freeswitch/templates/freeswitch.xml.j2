<?xml version="1.0"?>
<!-- {{ ansible_managed }} -->
<document type="freeswitch/xml">
  <!-- Phones and softphones (Meow) offer optional SRTP as a=crypto on RTP/AVP; FreeSWITCH
       refuses such offers (488) unless this is set. The offer is checked before any dialplan
       runs, so it is a global variable (channel variables fall back to globals). -->
  <X-PRE-PROCESS cmd="set" data="rtp_allow_crypto_in_avp=true"/>
  <!-- Accept SRTP (SDES) from phones that offer it, plain RTP from the rest. Without this the
       crypto offer is not negotiated and the answer carries no audio (m=audio 0). Calls placed
       to phones stay plain for now. -->
  <X-PRE-PROCESS cmd="set" data="rtp_secure_media_inbound=optional"/>
  <section name="configuration" description="Various Configuration">
    <X-PRE-PROCESS cmd="include" data="autoload_configs/*.xml"/>
  </section>
  <section name="dialplan" description="Static fallback, used only when Elixir does not answer">
    <context name="public">
      <extension name="unavailable">
        <condition field="destination_number" expression=".*">
          <action application="respond" data="503 Service Unavailable"/>
        </condition>
      </extension>
    </context>
  </section>
</document>
