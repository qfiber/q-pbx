<!-- {{ ansible_managed }} -->
<configuration name="xml_curl.conf" description="Dialplan from Elixir (call control)">
  <bindings>
    <!-- Every new call asks the app; it answers "park" and its call process takes over. If the
         app does not answer within 3 s, the static dialplan in freeswitch.xml is used. -->
    <binding name="dialplan">
      <param name="gateway-url" value="http://127.0.0.1:4000/internal/freeswitch/dialplan" bindings="dialplan"/>
      <param name="gateway-credentials" value="freeswitch:{{ qpbx_secrets.fs_curl_password }}"/>
      <param name="auth-scheme" value="basic"/>
      <param name="timeout" value="3"/>
      <param name="disable-100-continue" value="true"/>
    </binding>
  </bindings>
</configuration>
