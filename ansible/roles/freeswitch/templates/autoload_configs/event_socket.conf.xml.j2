<!-- {{ ansible_managed }} -->
<configuration name="event_socket.conf" description="Event socket (Elixir call control)">
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="127.0.0.1"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="{{ qpbx_secrets.esl_password }}"/>
    <param name="apply-inbound-acl" value="loopback.auto"/>
  </settings>
</configuration>
