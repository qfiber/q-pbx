#!/bin/sh
# {{ ansible_managed }}
# Writes /etc/kamailio/tls.cfg: the main certificate by default, plus one SNI profile per
# tenant SIP domain that has its own certificate ({{ qpbx_tls_dir }}/tenants/<domain>/).
# Run at install and after every certificate change (qpbx-tls-reload), then tls.reload.
set -eu
dir={{ qpbx_tls_dir }}
out=/etc/kamailio/tls.cfg
tmp=$(mktemp /etc/kamailio/.tls.cfg.XXXXXX)
trap 'rm -f "$tmp"' EXIT
{
  cat <<CFG
# Generated by qpbx-kamailio-tls; do not edit.
[server:default]
method = TLSv1.2+
verify_certificate = no
require_certificate = no
certificate = $dir/fullchain.pem
private_key = $dir/privkey.pem

[client:default]
method = TLSv1.2+
verify_certificate = yes
require_certificate = yes
CFG
  for d in "$dir"/tenants/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    case $name in *[!a-z0-9.-]*|'') continue ;; esac
    [ -s "$d/fullchain.pem" ] && [ -s "$d/privkey.pem" ] || continue
    printf '\n[server:any]\nmethod = TLSv1.2+\nverify_certificate = no\nrequire_certificate = no\n'
    printf 'certificate = %s\nprivate_key = %s\nserver_name = %s\nserver_name_mode = 0\n' \
      "$d/fullchain.pem" "$d/privkey.pem" "$name"
  done
} > "$tmp"
chgrp kamailio "$tmp"
chmod 0640 "$tmp"
mv "$tmp" "$out"
trap - EXIT
