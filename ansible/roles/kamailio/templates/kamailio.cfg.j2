#!KAMAILIO
# {{ ansible_managed }}
#
# The SIP edge. Everything outside enters here; FreeSWITCH (127.0.0.1:5080) is reached only
# through Kamailio and runs every call.
#  - Phones authenticate with digest against credential hashes (tenant = their SIP domain).
#  - Carriers are recognised by source address (dispatcher) or, for registration trunks, by
#    the R-URI user Kamailio registered as (the trunk's id). No authentication for them.
#  - Calls from FreeSWITCH go to a phone (location) or a trunk (X-QPBX-Trunk-Edge header),
#    failing over across the trunk's addresses.
# Configuration lives in memory, loaded from read-only database views and reloaded over
# JSON-RPC by the app (QPBX.Edge) when it changes; no Kamailio restart.

#!include_file "/etc/kamailio/db.cfg"

#!define CORE_URI "sip:127.0.0.1:5080"
#!define FLT_NATS 5
#!define FLB_NATB 6
#!define FLB_NATSIPPING 7

debug=2
log_stderror=no
log_facility=LOG_LOCAL0
children=4
tcp_children=4
enable_tls=yes
auto_aliases=no
# Several sockets (outside and loopback): pick the right one per destination.
mhomed=1
server_header="Server: Q-PBX"
user_agent_header="User-Agent: Q-PBX"

listen=udp:{{ qpbx_service_ipv4 }}:5060
listen=tcp:{{ qpbx_service_ipv4 }}:5060
listen=tls:{{ qpbx_service_ipv4 }}:5061
{% if qpbx_service_ipv6 %}
listen=udp:[{{ qpbx_service_ipv6 }}]:5060
listen=tcp:[{{ qpbx_service_ipv6 }}]:5060
listen=tls:[{{ qpbx_service_ipv6 }}]:5061
{% endif %}
# FreeSWITCH talks to Kamailio here.
listen=udp:127.0.0.1:5060
listen=tcp:127.0.0.1:5060
# JSON-RPC over HTTP for the app, localhost only.
listen=tcp:127.0.0.1:5071

loadmodule "kex.so"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "sanity.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "tls.so"
loadmodule "xhttp.so"
loadmodule "jsonrpcs.so"
loadmodule "db_postgres.so"
loadmodule "htable.so"
loadmodule "auth.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"
loadmodule "nathelper.so"
loadmodule "dispatcher.so"
loadmodule "permissions.so"
loadmodule "uac.so"
loadmodule "json.so"
loadmodule "presence.so"
loadmodule "presence_xml.so"
loadmodule "presence_dialoginfo.so"
loadmodule "presence_mwi.so"
loadmodule "pua_json.so"
loadmodule "http_async_client.so"

modparam("tls", "config", "/etc/kamailio/tls.cfg")
modparam("jsonrpcs", "transport", 1)
modparam("rr", "enable_full_lr", 1)
# Several sockets (mhomed): see the tm README on DNS failover re-parsing.
modparam("tm", "reparse_on_dns_failover", 0)

# Tenant domains, credential hashes and trunks, in memory (htable.reload on change).
modparam("htable", "db_url", DBURL)
modparam("htable", "htable", "domains=>size=8;dbtable=domains;")
modparam("htable", "htable", "credentials=>size=12;dbtable=credentials;")
modparam("htable", "htable", "trunks=>size=8;dbtable=trunks;")

# Edge protection. Thresholds come from the admin panel (htable "settings", reloaded on change).
# Keys: "<ip>" (whole address) or "<ip>|<port>" (one phone).
#  ipban: bans, each with its own expiry; loaded from the database at start (the app stores
#    every ban), so a restart keeps them
#  counters: request and failure counts in fixed time buckets (flood 2 s, rate 1 min,
#    failed logins 15 min); in memory only
#  edgealert: office IPs that would have been banned; the app raises an alert
modparam("htable", "db_expires", 1)
modparam("htable", "htable", "settings=>size=4;dbtable=settings;")
modparam("htable", "htable", "ipban=>size=12;autoexpire=2592000;dbtable=ipban;")
modparam("htable", "htable", "counters=>size=14;autoexpire=1000;updateexpire=0;")
modparam("htable", "htable", "edgealert=>size=8;autoexpire=3600;updateexpire=0;")
modparam("htable", "timer_interval", 10)

# Busy lamps, presence and voicemail lights: Kamailio answers the phones' subscriptions; the
# app publishes call states and message counts as JSON on /presence (pua_json). All in memory:
# runtime state the app rebuilds.
modparam("presence", "publ_cache", 2)
modparam("presence", "subs_db_mode", 0)
modparam("presence", "server_address", "sip:presence@{{ qpbx_service_ipv4 }}:5060")
modparam("presence_xml", "force_active", 1)
modparam("presence_xml", "disable_winfo", 1)
modparam("presence_xml", "force_dummy_presence", 1)
# An extension with no state yet reads as idle, not unknown.
modparam("presence_dialoginfo", "force_dummy_dialog", 1)

# Registrations in memory, one location table across tenants (address of record user@domain).
modparam("usrloc", "db_mode", 0)
modparam("usrloc", "use_domain", 1)
modparam("usrloc", "nat_bflag", FLB_NATB)
modparam("registrar", "received_avp", "$avp(RECEIVED)")
modparam("registrar", "max_expires", 3600)
modparam("registrar", "min_expires", 60)

# NAT: phones behind NAT are reached at the address their REGISTER came from, and kept open
# with SIP OPTIONS every 30 s.
modparam("nathelper", "received_avp", "$avp(RECEIVED)")
modparam("nathelper", "natping_interval", 30)
modparam("nathelper", "ping_nated_only", 1)
modparam("nathelper", "sipping_bflag", FLB_NATSIPPING)
modparam("nathelper", "sipping_from", "sip:pinger@{{ qpbx_service_ipv4 }}")

# IP carrier trunks: one set per trunk, one destination per address (registration trunks are
# identified by the R-URI user instead, and call their registrar). Every address is pinged
# with OPTIONS; one that does not answer is skipped until it answers again.
modparam("dispatcher", "db_url", DBURL)
modparam("dispatcher", "table_name", "dispatcher")
modparam("dispatcher", "flags", 2)
modparam("dispatcher", "ds_ping_interval", 20)
modparam("dispatcher", "ds_probing_threshold", 2)
modparam("dispatcher", "ds_inactive_threshold", 2)
modparam("dispatcher", "ds_probing_mode", 1)
modparam("dispatcher", "ds_ping_from", "sip:ping@{{ qpbx_service_ipv4 }}")
# A carrier answering OPTIONS with an error is still reachable. Not 408 and not 5xx: the
# transaction layer makes those itself when nothing answers (a timeout, a failed send), and
# accepting them would keep a dead carrier "active" forever. 501: OPTIONS not implemented.
modparam("dispatcher", "ds_ping_reply_codes", "class=2;code=400;code=401;code=403;code=404;code=405;code=407;code=480;code=481;code=484;code=488;code=489;code=501")
# Host names: resolved at load and refreshed every 10 minutes.
modparam("dispatcher", "ds_dns_mode", 5)
modparam("dispatcher", "setid_pvname", "$avp(ds_setid)")
modparam("dispatcher", "attrs_pvname", "$avp(ds_attrs)")

# Allow lists (permissions "address" view): group 1 platform, group 2 tenant office IPs.
# Used by edge protection (2-4); loaded and reloaded here.
modparam("permissions", "db_url", DBURL)
modparam("permissions", "address_table", "address")
modparam("permissions", "db_mode", 1)
modparam("permissions", "load_backends", 1)

# Registration trunks: Kamailio registers to the carrier. Records (with the password) come
# from the app over JSON-RPC (uac.reg_add); the database view only starts the feature.
modparam("uac", "reg_db_url", DBURL)
modparam("uac", "reg_db_table", "uacreg")
modparam("uac", "reg_contact_addr", "{{ qpbx_service_ipv4 }}:5060")
modparam("uac", "reg_timer_interval", 30)
modparam("uac", "reg_retry_interval", 60)
modparam("uac", "reg_keep_callid", 1)
modparam("uac", "auth_username_avp", "$avp(auser)")
modparam("uac", "auth_password_avp", "$avp(apass)")
modparam("uac", "auth_realm_avp", "$avp(arealm)")

request_route {
  if ($Rp == 5071) {
    drop;
  }
  route(REQINIT);
  route(NATDETECT);

  if (is_method("CANCEL")) {
    if (t_check_trans()) {
      route(RELAY);
    }
    exit;
  }

  # Q-PBX headers are trusted only from FreeSWITCH.
  if (!route(FROM_CORE_ADDR)) {
    route(PROTECT);
    remove_hf_re("^X-QPBX-");
  }

  # Subscriptions (and their in-dialog refreshes) and presence publications end here.
  if (!route(FROM_CORE_ADDR)) {
    if (is_method("SUBSCRIBE")) {
      route(SUBSCRIBE);
    }
    if (is_method("PUBLISH")) {
      route(PUBLISH);
    }
  }

  route(WITHINDLG);

  if (!is_method("ACK")) {
    if (t_precheck_trans()) {
      t_check_trans();
      exit;
    }
    t_check_trans();
  }

  if (route(FROM_CORE_ADDR)) {
    route(FROM_CORE);
    exit;
  }

  if (is_method("REGISTER")) {
    route(REGISTER);
  }
  if (is_method("OPTIONS") && $rU == $null) {
    sl_send_reply("200", "OK");
    exit;
  }
  if (is_method("INVITE")) {
    route(INVITE);
  }
  sl_send_reply("501", "Not Implemented");
  exit;
}

route[REQINIT] {
  if (!mf_process_maxfwd_header("10")) {
    sl_send_reply("483", "Too Many Hops");
    exit;
  }
  if (!sanity_check("17895", "7")) {
    exit;
  }
}

# Every request from outside. Platform allowlist: never limited. Banned: dropped silently.
route[PROTECT] {
  $var(office) = 0;
  if (allow_source_address("1")) {
    return;
  }
  if (allow_source_address("2")) {
    $var(office) = 1;
  }
  if ($sht(ipban=>$si) != $null || $sht(ipban=>$si|$sp) != $null) {
    drop;
    exit;
  }
  route(SETTINGS);
  if ($ua != $null && $ua =~ $var(s_agents)) {
    xlog("L_WARN", "edge: scanner user agent [$ua] from $si\n");
    $var(reason) = "scanner";
    route(BAN_IP);
    drop;
    exit;
  }
  # Flood: requests per address in 2-second buckets (office IPs skip it: many phones).
  if ($var(office) == 0) {
    $var(key) = "f|" + $si + "|" + ($Ts / 2);
    route(COUNT);
    if ($var(n) > $var(s_flood)) {
      xlog("L_WARN", "edge: flood from $si\n");
      $var(reason) = "flood";
      route(BAN_IP);
      drop;
      exit;
    }
  }
  if (!has_totag()) {
    if (is_method("REGISTER")) {
      $var(limit) = $var(s_register);
      route(RATE);
    } else if (is_method("INVITE")) {
      $var(limit) = $var(s_invite);
      route(RATE);
    }
  }
}

# The admin panel's settings, with safe defaults if they are missing.
route[SETTINGS] {
  $var(s_flood) = 40;
  $var(s_register) = 30;
  $var(s_invite) = 30;
  $var(s_fail_port) = 10;
  $var(s_fail_ip) = 30;
  $var(s_ban) = 3600;
  $var(s_agents) = "friendly-scanner|sipvicious|sipcli";
  if ($sht(settings=>flood_requests) != $null) {
    $var(s_flood) = $sht(settings=>flood_requests);
  }
  if ($sht(settings=>register_per_minute) != $null) {
    $var(s_register) = $sht(settings=>register_per_minute);
  }
  if ($sht(settings=>invite_per_minute) != $null) {
    $var(s_invite) = $sht(settings=>invite_per_minute);
  }
  if ($sht(settings=>auth_failures_port) != $null) {
    $var(s_fail_port) = $sht(settings=>auth_failures_port);
  }
  if ($sht(settings=>auth_failures_ip) != $null) {
    $var(s_fail_ip) = $sht(settings=>auth_failures_ip);
  }
  if ($sht(settings=>ban_seconds) != $null) {
    $var(s_ban) = $sht(settings=>ban_seconds);
  }
  if ($sht(settings=>scanner_agents) != $null) {
    $var(s_agents) = $sht(settings=>scanner_agents);
  }
}

# Increments counters $var(key) and sets $var(n). ($shtinc does not create a missing key.)
route[COUNT] {
  if ($sht(counters=>$var(key)) == $null) {
    $sht(counters=>$var(key)) = 0;
  }
  $var(n) = $shtinc(counters=>$var(key));
}

# REGISTER or INVITE per address and port per minute ($var(limit)): over it, refused; three
# times over, that address and port banned.
route[RATE] {
  $var(key) = "r|" + $rm + "|" + $si + "|" + $sp + "|" + ($Ts / 60);
  route(COUNT);
  if ($var(n) > $var(limit)) {
    if ($var(n) > 3 * $var(limit)) {
      $var(ban) = $si + "|" + $sp;
      $var(reason) = "rate";
      route(BAN);
    }
    append_to_reply("Retry-After: 60\r\n");
    sl_send_reply("503", "Rate Limited");
    exit;
  }
}

# A failed authentication (wrong password, unknown user, someone else's user), counted per
# address and port and per address in 15-minute buckets.
route[AUTHFAIL] {
  route(SETTINGS);
  $var(bucket) = $Ts / 900;
  $var(key) = "a|" + $si + "|" + $sp + "|" + $var(bucket);
  route(COUNT);
  $var(n_port) = $var(n);
  $var(key) = "a|" + $si + "|" + $var(bucket);
  route(COUNT);
  $var(port_limit) = $var(s_fail_port);
  if ($var(office) == 1) {
    $var(port_limit) = 3 * $var(s_fail_port);
  }
  if ($var(n_port) >= $var(port_limit)) {
    $var(ban) = $si + "|" + $sp;
    # The domain names the tenant whose logins were tried (QPBX.Edge.Bans: the alert).
    $var(reason) = "auth failures " + $td;
    route(BAN);
  }
  if ($var(n) >= $var(s_fail_ip)) {
    # The domain names the tenant whose logins were tried (QPBX.Edge.Bans: the alert).
    $var(reason) = "auth failures " + $td;
    route(BAN_IP);
  }
}

# Bans $var(ban) for the configured time.
route[BAN] {
  $sht(ipban=>$var(ban)) = $var(reason);
  $shtex(ipban=>$var(ban)) = $var(s_ban);
  xlog("L_WARN", "edge: banned $var(ban) ($var(reason))\n");
}

# Bans the whole source address; an office IP is never banned as a whole: it is flagged for an
# alert instead.
route[BAN_IP] {
  if ($var(office) == 1) {
    if ($sht(edgealert=>$si) == $null) {
      $sht(edgealert=>$si) = $var(reason);
      xlog("L_WARN", "edge: office IP $si would be banned ($var(reason)); alerting\n");
    }
    return;
  }
  $var(ban) = $si;
  route(BAN);
}

# Digest authentication against the credential hashes, realm = tenant domain ($var(realm)).
# No credentials yet: a challenge. Wrong ones: counted, then a challenge.
route[AUTH] {
  if ($au == $null) {
    auth_challenge("$var(realm)", "1");
    exit;
  }
  if ($sht(credentials=>$au@$var(realm)) == $null) {
    route(AUTHFAIL);
    auth_challenge("$var(realm)", "1");
    exit;
  }
  pv_auth_check("$var(realm)", "$sht(credentials=>$au@$var(realm))", "1", "1");
  $var(rc) = $rc;
  if ($var(rc) < 0) {
    # -2 wrong password, -8 the From/To user is not the authenticated user; a stale nonce
    # (-4, -6) is normal and not counted.
    if ($var(rc) == -2 || $var(rc) == -8) {
      route(AUTHFAIL);
    }
    auth_challenge("$var(realm)", "1");
    exit;
  }
  consume_credentials();
}

# A phone watches extensions of its own tenant: busy lamps (dialog), presence and its voicemail
# light (message-summary).
route[SUBSCRIBE] {
  if ($sht(domains=>$fd) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  if (!($hdr(Event) =~ "^(dialog|presence|message-summary)")) {
    sl_send_reply("489", "Bad Event");
    exit;
  }
  $var(realm) = $fd;
  route(AUTH);
  if ($rd != $fd) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  if (!t_newtran()) {
    sl_reply_error();
    exit;
  }
  handle_subscribe();
  t_release();
  exit;
}

# A phone publishes its own presence only.
route[PUBLISH] {
  if ($sht(domains=>$fd) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  $var(realm) = $fd;
  route(AUTH);
  if ($rd != $fd || $rU != $au) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  if (!t_newtran()) {
    sl_reply_error();
    exit;
  }
  handle_publish();
  t_release();
  exit;
}

route[FROM_CORE_ADDR] {
  if ($si == "127.0.0.1" && $sp == 5080) {
    return 1;
  }
  return -1;
}

route[NATDETECT] {
  force_rport();
  if (nat_uac_test("19")) {
    if (is_method("REGISTER")) {
      fix_nated_register();
    } else if (is_method("SUBSCRIBE")) {
      # Notifications go to where the subscription came from.
      fix_nated_contact();
    } else if (is_first_hop()) {
      set_contact_alias();
    }
    setflag(FLT_NATS);
  }
}

# The tenant is the To domain; its SIP domain is the digest realm. A phone may register only
# the user it authenticated as (pv_auth_check checks the To user against the auth user).
route[REGISTER] {
  if ($sht(domains=>$td) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  $var(realm) = $td;
  route(AUTH);
  if (isflagset(FLT_NATS)) {
    setbflag(FLB_NATB);
    setbflag(FLB_NATSIPPING);
  }
  # One login is one device: a new registration replaces its older contacts (a phone that
  # re-registers from a new port would otherwise be forked to twice, and a busy or redirect
  # from one branch held until the stale branch times out).
  $var(saved) = save("location", "0x04");
  if ($var(saved) < 0) {
    sl_reply_error();
    exit;
  }
  # Only real changes reach the app (a renewal, code 2, does not): 1 a new contact, 3 removed.
  if ($var(saved) == 1 || $var(saved) == 3) {
    $var(rep_event) = "unregistered";
    if ($var(saved) == 1) {
      $var(rep_event) = "registered";
    }
    $var(rep_aor) = $tU + "@" + $td;
    $var(rep_contact) = $si + ":" + $sp;
    $var(rep_ua) = "";
    if (is_present_hf("User-Agent")) {
      $var(rep_ua) = $(hdr(User-Agent){s.encode.hexa});
    }
    route(REG_REPORT);
  }
  exit;
}

# A contact ran out without being renewed: the device is no longer registered.
event_route[usrloc:contact-expired] {
  $var(rep_event) = "expired";
  $var(rep_aor) = $ulc(exp=>aor);
  $var(rep_contact) = $ulc(exp=>addr);
  $var(rep_ua) = $(ulc(exp=>user_agent){s.encode.hexa});
  route(REG_REPORT);
}

# Reports a registration change to the app (QPBX.Edge.RegistrationEvents) without holding up
# the SIP reply: http_async_client sends it from its own worker. The user agent goes
# hex-encoded (any character a phone puts there stays out of the JSON).
route[REG_REPORT] {
  $http_req(all) = $null;
  $http_req(suspend) = 0;
  $http_req(timeout) = 2000;
  $http_req(method) = "POST";
  $http_req(hdr) = "Content-Type: application/json";
  $http_req(hdr) = "X-QPBX-Secret: " + EVENT_SECRET;
  $http_req(body) = "{\"event\":\"" + $var(rep_event) + "\",\"aor\":\"" + $var(rep_aor) + "\",\"contact\":\"" + $var(rep_contact) + "\",\"ua_hex\":\"" + $var(rep_ua) + "\"}";
  http_async_query("http://127.0.0.1:4000/internal/kamailio/registration", "REG_REPORT_REPLY");
}

route[REG_REPORT_REPLY] {
  if (!$http_ok || $http_rs != 204) {
    xlog("L_WARN", "registration report not taken: $http_rs $http_err\n");
  }
}

# A new call from outside: a registration trunk's carrier (the R-URI user is the trunk id
# Kamailio registered as), an IP trunk's carrier (by source address), else a phone that must
# authenticate.
route[INVITE] {
  if ($rU != $null && $sht(trunks=>reg:$rU) != $null) {
    $var(edge) = $sht(trunks=>reg:$rU);
    route(FROM_TRUNK);
  }
  if (ds_is_from_list("-1", "3")) {
    $var(edge) = $avp(ds_setid);
    route(FROM_TRUNK);
  }

  # ($var cannot hold "no value": test htable entries directly.)
  if ($sht(domains=>$fd) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  # Digest with the tenant domain as realm; the From user must be the authenticated user.
  $var(realm) = $fd;
  route(AUTH);
  append_hf("X-QPBX-Source: device\r\n");
  append_hf("X-QPBX-Tenant: $sht(domains=>$fd)\r\n");
  append_hf("X-QPBX-Auth-User: $au\r\n");
  route(TO_CORE);
}

route[FROM_TRUNK] {
  if ($sht(trunks=>$var(edge)) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  $var(info) = $sht(trunks=>$var(edge));
  append_hf("X-QPBX-Source: trunk\r\n");
  append_hf("X-QPBX-Trunk: $(var(info){s.select,0,;})\r\n");
  if ($(var(info){s.select,1,;}) != "") {
    append_hf("X-QPBX-Tenant: $(var(info){s.select,1,;})\r\n");
  }
  route(TO_CORE);
}

route[TO_CORE] {
  record_route();
  $du = CORE_URI;
  route(RELAY);
}

# A new call from FreeSWITCH: to a carrier when it names a trunk, else to a registered phone.
route[FROM_CORE] {
  $var(to_trunk) = 0;
  if (is_present_hf("X-QPBX-Trunk-Edge")) {
    $var(to_trunk) = 1;
    $avp(edge) = $(hdr(X-QPBX-Trunk-Edge){s.int});
  }
  remove_hf_re("^X-QPBX-");
  record_route();

  if ($var(to_trunk) == 1) {
    if ($sht(trunks=>$avp(edge)) == $null) {
      send_reply("503", "Trunk Unavailable");
      exit;
    }
    $var(info) = $sht(trunks=>$avp(edge));
    # A registration trunk: its registrar, answering the carrier's challenge on failure.
    if ($(var(info){s.select,2,;}) == "registration") {
      $du = $(var(info){s.select,3,;});
      t_on_failure("TRUNK_FAILOVER");
      route(RELAY);
    }
    # An IP trunk: its addresses by priority.
    if (!ds_select_dst("$avp(edge)", "8")) {
      send_reply("503", "Trunk Unavailable");
      exit;
    }
    # Move to the next address if this one does not answer within 4 s.
    t_set_fr(120000, 4000);
    t_on_failure("TRUNK_FAILOVER");
    route(RELAY);
  }

  if (!lookup("location")) {
    sl_send_reply("480", "Temporarily Unavailable");
    exit;
  }
  route(RELAY);
}

failure_route[TRUNK_FAILOVER] {
  if (t_is_canceled()) {
    exit;
  }
  # A registration trunk asks for credentials: answer with its registration's.
  if ($sht(trunks=>$avp(edge)) == $null) {
    exit;
  }
  $var(info) = $sht(trunks=>$avp(edge));
  if (t_check_status("401|407") && $(var(info){s.select,2,;}) == "registration" && $avp(auth_tried) == $null) {
    $avp(auth_tried) = 1;
    if (uac_reg_request_to("$(var(info){s.select,0,;})", "0") && uac_auth()) {
      t_on_failure("TRUNK_FAILOVER");
      route(RELAY);
    }
    exit;
  }
  if (t_branch_timeout() || t_check_status("408|5[0-9][0-9]")) {
    if (t_branch_timeout()) {
      ds_mark_dst("ip");
    }
    if (ds_next_dst()) {
      $avp(auth_tried) = $null;
      t_on_failure("TRUNK_FAILOVER");
      route(RELAY);
    }
  }
}

route[RELAY] {
  if (is_method("INVITE|BYE|UPDATE")) {
    if (!t_is_set("branch_route")) {
      t_on_branch("MANAGE_BRANCH");
    }
  }
  if (is_method("INVITE|UPDATE")) {
    if (!t_is_set("onreply_route")) {
      t_on_reply("MANAGE_REPLY");
    }
  }
  if (!t_relay()) {
    sl_reply_error();
  }
  exit;
}

route[WITHINDLG] {
  if (!has_totag()) {
    return;
  }
  if (loose_route()) {
    # Every call runs through FreeSWITCH: an outside party may only reach it, never another
    # outside address through us.
    if (!route(FROM_CORE_ADDR)) {
      if (isdsturiset()) {
        $var(next) = $du;
      } else {
        $var(next) = $ru;
      }
      if ($(var(next){uri.host}) != "127.0.0.1" || $(var(next){uri.port}) != "5080") {
        sl_send_reply("403", "Forbidden");
        exit;
      }
    }
    if (!isdsturiset()) {
      handle_ruri_alias();
    }
    if (is_method("ACK")) {
      route(NATMANAGE);
    }
    route(RELAY);
  }
  if (is_method("ACK")) {
    if (t_check_trans()) {
      route(RELAY);
    }
    exit;
  }
  sl_send_reply("404", "Not Here");
  exit;
}

route[NATMANAGE] {
  if (is_request()) {
    if (has_totag()) {
      if (check_route_param("nat=yes")) {
        setbflag(FLB_NATB);
      }
    }
  }
  if (!(isflagset(FLT_NATS) || isbflagset(FLB_NATB))) {
    return;
  }
  if (is_request()) {
    if (!has_totag()) {
      if (t_is_branch_route()) {
        add_rr_param(";nat=yes");
      }
    }
  }
  if (is_reply()) {
    if (isbflagset(FLB_NATB)) {
      if (is_first_hop()) {
        set_contact_alias();
      }
    }
  }
}

branch_route[MANAGE_BRANCH] {
  route(NATMANAGE);
}

onreply_route[MANAGE_REPLY] {
  if (status =~ "[12][0-9][0-9]") {
    route(NATMANAGE);
  }
}

event_route[xhttp:request] {
  if ($Rp != 5071 || $si != "127.0.0.1") {
    xhttp_reply("403", "Forbidden", "", "");
    exit;
  }
  if ($hu =~ "^/RPC") {
    jsonrpc_dispatch();
  } else if ($hu =~ "^/presence") {
    if (pua_json_publish($rb)) {
      xhttp_reply("200", "OK", "text/plain", "ok\n");
    } else {
      xhttp_reply("400", "Bad Request", "text/plain", "rejected\n");
    }
  } else {
    xhttp_reply("404", "Not Found", "", "");
  }
  exit;
}
