#!KAMAILIO
# {{ ansible_managed }}
#
# The SIP edge. Everything outside enters here; FreeSWITCH (127.0.0.1:5080) is reached only
# through Kamailio and runs every call.
#  - Phones authenticate with digest against credential hashes (tenant = their SIP domain).
#  - Carriers are recognised by source address (dispatcher) or, for registration trunks, by
#    the R-URI user Kamailio registered as (the trunk's id). No authentication for them.
#  - Calls from FreeSWITCH go to a phone (location) or a trunk (X-QPBX-Trunk-Edge header),
#    failing over across the trunk's addresses.
# Configuration lives in memory, loaded from read-only database views and reloaded over
# JSON-RPC by the app (QPBX.Edge) when it changes; no Kamailio restart.

#!include_file "/etc/kamailio/db.cfg"

#!define CORE_URI "sip:127.0.0.1:5080"
#!define FLT_NATS 5
#!define FLB_NATB 6
#!define FLB_NATSIPPING 7

debug=2
log_stderror=no
log_facility=LOG_LOCAL0
children=4
tcp_children=4
enable_tls=yes
auto_aliases=no
# Several sockets (outside and loopback): pick the right one per destination.
mhomed=1
server_header="Server: Q-PBX"
user_agent_header="User-Agent: Q-PBX"

listen=udp:{{ qpbx_service_ipv4 }}:5060
listen=tcp:{{ qpbx_service_ipv4 }}:5060
listen=tls:{{ qpbx_service_ipv4 }}:5061
{% if qpbx_service_ipv6 %}
listen=udp:[{{ qpbx_service_ipv6 }}]:5060
listen=tcp:[{{ qpbx_service_ipv6 }}]:5060
listen=tls:[{{ qpbx_service_ipv6 }}]:5061
{% endif %}
# FreeSWITCH talks to Kamailio here.
listen=udp:127.0.0.1:5060
listen=tcp:127.0.0.1:5060
# JSON-RPC over HTTP for the app, localhost only.
listen=tcp:127.0.0.1:5071

loadmodule "kex.so"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "sanity.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "tls.so"
loadmodule "xhttp.so"
loadmodule "jsonrpcs.so"
loadmodule "db_postgres.so"
loadmodule "htable.so"
loadmodule "auth.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"
loadmodule "nathelper.so"
loadmodule "dispatcher.so"
loadmodule "permissions.so"
loadmodule "uac.so"

modparam("tls", "config", "/etc/kamailio/tls.cfg")
modparam("jsonrpcs", "transport", 1)
modparam("rr", "enable_full_lr", 1)
# Several sockets (mhomed): see the tm README on DNS failover re-parsing.
modparam("tm", "reparse_on_dns_failover", 0)

# Tenant domains, credential hashes and trunks, in memory (htable.reload on change).
modparam("htable", "db_url", DBURL)
modparam("htable", "htable", "domains=>size=8;dbtable=domains;")
modparam("htable", "htable", "credentials=>size=12;dbtable=credentials;")
modparam("htable", "htable", "trunks=>size=8;dbtable=trunks;")

# Registrations in memory, one location table across tenants (address of record user@domain).
modparam("usrloc", "db_mode", 0)
modparam("usrloc", "use_domain", 1)
modparam("usrloc", "nat_bflag", FLB_NATB)
modparam("registrar", "received_avp", "$avp(RECEIVED)")
modparam("registrar", "max_expires", 3600)
modparam("registrar", "min_expires", 60)

# NAT: phones behind NAT are reached at the address their REGISTER came from, and kept open
# with SIP OPTIONS every 30 s.
modparam("nathelper", "received_avp", "$avp(RECEIVED)")
modparam("nathelper", "natping_interval", 30)
modparam("nathelper", "ping_nated_only", 1)
modparam("nathelper", "sipping_bflag", FLB_NATSIPPING)
modparam("nathelper", "sipping_from", "sip:pinger@{{ qpbx_service_ipv4 }}")

# IP carrier trunks: one set per trunk, one destination per address (registration trunks are
# identified by the R-URI user instead, and call their registrar). Every address is pinged
# with OPTIONS; one that does not answer is skipped until it answers again.
modparam("dispatcher", "db_url", DBURL)
modparam("dispatcher", "table_name", "dispatcher")
modparam("dispatcher", "flags", 2)
modparam("dispatcher", "ds_ping_interval", 20)
modparam("dispatcher", "ds_probing_threshold", 2)
modparam("dispatcher", "ds_inactive_threshold", 2)
modparam("dispatcher", "ds_probing_mode", 1)
modparam("dispatcher", "ds_ping_from", "sip:ping@{{ qpbx_service_ipv4 }}")
# A carrier answering OPTIONS with an error is still reachable.
modparam("dispatcher", "ds_ping_reply_codes", "class=2;class=4;class=5")
# Host names: resolved at load and refreshed every 10 minutes.
modparam("dispatcher", "ds_dns_mode", 5)
modparam("dispatcher", "setid_pvname", "$avp(ds_setid)")
modparam("dispatcher", "attrs_pvname", "$avp(ds_attrs)")

# Allow lists (permissions "address" view): group 1 platform, group 2 tenant office IPs.
# Used by edge protection (2-4); loaded and reloaded here.
modparam("permissions", "db_url", DBURL)
modparam("permissions", "address_table", "address")
modparam("permissions", "db_mode", 1)
modparam("permissions", "load_backends", 1)

# Registration trunks: Kamailio registers to the carrier. Records (with the password) come
# from the app over JSON-RPC (uac.reg_add); the database view only starts the feature.
modparam("uac", "reg_db_url", DBURL)
modparam("uac", "reg_db_table", "uacreg")
modparam("uac", "reg_contact_addr", "{{ qpbx_service_ipv4 }}:5060")
modparam("uac", "reg_timer_interval", 30)
modparam("uac", "reg_retry_interval", 60)
modparam("uac", "reg_keep_callid", 1)
modparam("uac", "auth_username_avp", "$avp(auser)")
modparam("uac", "auth_password_avp", "$avp(apass)")
modparam("uac", "auth_realm_avp", "$avp(arealm)")

request_route {
  if ($Rp == 5071) {
    drop;
  }
  route(REQINIT);
  route(NATDETECT);

  if (is_method("CANCEL")) {
    if (t_check_trans()) {
      route(RELAY);
    }
    exit;
  }

  # Q-PBX headers are trusted only from FreeSWITCH.
  if (!route(FROM_CORE_ADDR)) {
    remove_hf_re("^X-QPBX-");
  }

  route(WITHINDLG);

  if (!is_method("ACK")) {
    if (t_precheck_trans()) {
      t_check_trans();
      exit;
    }
    t_check_trans();
  }

  if (route(FROM_CORE_ADDR)) {
    route(FROM_CORE);
    exit;
  }

  if (is_method("REGISTER")) {
    route(REGISTER);
  }
  if (is_method("OPTIONS") && $rU == $null) {
    sl_send_reply("200", "OK");
    exit;
  }
  if (is_method("INVITE")) {
    route(INVITE);
  }
  sl_send_reply("501", "Not Implemented");
  exit;
}

route[REQINIT] {
  if (!mf_process_maxfwd_header("10")) {
    sl_send_reply("483", "Too Many Hops");
    exit;
  }
  if (!sanity_check("17895", "7")) {
    exit;
  }
}

route[FROM_CORE_ADDR] {
  if ($si == "127.0.0.1" && $sp == 5080) {
    return 1;
  }
  return -1;
}

route[NATDETECT] {
  force_rport();
  if (nat_uac_test("19")) {
    if (is_method("REGISTER")) {
      fix_nated_register();
    } else if (is_first_hop()) {
      set_contact_alias();
    }
    setflag(FLT_NATS);
  }
}

# The tenant is the To domain; its SIP domain is the digest realm. A phone may register only
# the user it authenticated as (pv_auth_check checks the To user against the auth user).
route[REGISTER] {
  if ($sht(domains=>$td) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  if ($au == $null || $sht(credentials=>$au@$td) == $null) {
    auth_challenge("$td", "1");
    exit;
  }
  if (!pv_auth_check("$td", "$sht(credentials=>$au@$td)", "1", "1")) {
    auth_challenge("$td", "1");
    exit;
  }
  consume_credentials();
  if (isflagset(FLT_NATS)) {
    setbflag(FLB_NATB);
    setbflag(FLB_NATSIPPING);
  }
  if (!save("location")) {
    sl_reply_error();
  }
  exit;
}

# A new call from outside: a registration trunk's carrier (the R-URI user is the trunk id
# Kamailio registered as), an IP trunk's carrier (by source address), else a phone that must
# authenticate.
route[INVITE] {
  if ($rU != $null && $sht(trunks=>reg:$rU) != $null) {
    $var(edge) = $sht(trunks=>reg:$rU);
    route(FROM_TRUNK);
  }
  if (ds_is_from_list("-1", "3")) {
    $var(edge) = $avp(ds_setid);
    route(FROM_TRUNK);
  }

  # ($var cannot hold "no value": test htable entries directly.)
  if ($sht(domains=>$fd) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  # Digest with the tenant domain as realm; the From user must be the authenticated user.
  if ($au == $null || $sht(credentials=>$au@$fd) == $null) {
    auth_challenge("$fd", "1");
    exit;
  }
  if (!pv_auth_check("$fd", "$sht(credentials=>$au@$fd)", "1", "1")) {
    auth_challenge("$fd", "1");
    exit;
  }
  consume_credentials();
  append_hf("X-QPBX-Source: device\r\n");
  append_hf("X-QPBX-Tenant: $sht(domains=>$fd)\r\n");
  append_hf("X-QPBX-Auth-User: $au\r\n");
  route(TO_CORE);
}

route[FROM_TRUNK] {
  if ($sht(trunks=>$var(edge)) == $null) {
    sl_send_reply("403", "Forbidden");
    exit;
  }
  $var(info) = $sht(trunks=>$var(edge));
  append_hf("X-QPBX-Source: trunk\r\n");
  append_hf("X-QPBX-Trunk: $(var(info){s.select,0,;})\r\n");
  if ($(var(info){s.select,1,;}) != "") {
    append_hf("X-QPBX-Tenant: $(var(info){s.select,1,;})\r\n");
  }
  route(TO_CORE);
}

route[TO_CORE] {
  record_route();
  $du = CORE_URI;
  route(RELAY);
}

# A new call from FreeSWITCH: to a carrier when it names a trunk, else to a registered phone.
route[FROM_CORE] {
  $var(to_trunk) = 0;
  if (is_present_hf("X-QPBX-Trunk-Edge")) {
    $var(to_trunk) = 1;
    $avp(edge) = $(hdr(X-QPBX-Trunk-Edge){s.int});
  }
  remove_hf_re("^X-QPBX-");
  record_route();

  if ($var(to_trunk) == 1) {
    if ($sht(trunks=>$avp(edge)) == $null) {
      send_reply("503", "Trunk Unavailable");
      exit;
    }
    $var(info) = $sht(trunks=>$avp(edge));
    # A registration trunk: its registrar, answering the carrier's challenge on failure.
    if ($(var(info){s.select,2,;}) == "registration") {
      $du = $(var(info){s.select,3,;});
      t_on_failure("TRUNK_FAILOVER");
      route(RELAY);
    }
    # An IP trunk: its addresses by priority.
    if (!ds_select_dst("$avp(edge)", "8")) {
      send_reply("503", "Trunk Unavailable");
      exit;
    }
    # Move to the next address if this one does not answer within 4 s.
    t_set_fr(120000, 4000);
    t_on_failure("TRUNK_FAILOVER");
    route(RELAY);
  }

  if (!lookup("location")) {
    sl_send_reply("480", "Temporarily Unavailable");
    exit;
  }
  route(RELAY);
}

failure_route[TRUNK_FAILOVER] {
  if (t_is_canceled()) {
    exit;
  }
  # A registration trunk asks for credentials: answer with its registration's.
  if ($sht(trunks=>$avp(edge)) == $null) {
    exit;
  }
  $var(info) = $sht(trunks=>$avp(edge));
  if (t_check_status("401|407") && $(var(info){s.select,2,;}) == "registration" && $avp(auth_tried) == $null) {
    $avp(auth_tried) = 1;
    if (uac_reg_request_to("$(var(info){s.select,0,;})", "0") && uac_auth()) {
      t_on_failure("TRUNK_FAILOVER");
      route(RELAY);
    }
    exit;
  }
  if (t_branch_timeout() || t_check_status("408|5[0-9][0-9]")) {
    if (t_branch_timeout()) {
      ds_mark_dst("ip");
    }
    if (ds_next_dst()) {
      $avp(auth_tried) = $null;
      t_on_failure("TRUNK_FAILOVER");
      route(RELAY);
    }
  }
}

route[RELAY] {
  if (is_method("INVITE|BYE|UPDATE")) {
    if (!t_is_set("branch_route")) {
      t_on_branch("MANAGE_BRANCH");
    }
  }
  if (is_method("INVITE|UPDATE")) {
    if (!t_is_set("onreply_route")) {
      t_on_reply("MANAGE_REPLY");
    }
  }
  if (!t_relay()) {
    sl_reply_error();
  }
  exit;
}

route[WITHINDLG] {
  if (!has_totag()) {
    return;
  }
  if (loose_route()) {
    # Every call runs through FreeSWITCH: an outside party may only reach it, never another
    # outside address through us.
    if (!route(FROM_CORE_ADDR)) {
      if (isdsturiset()) {
        $var(next) = $du;
      } else {
        $var(next) = $ru;
      }
      if ($(var(next){uri.host}) != "127.0.0.1" || $(var(next){uri.port}) != "5080") {
        sl_send_reply("403", "Forbidden");
        exit;
      }
    }
    if (!isdsturiset()) {
      handle_ruri_alias();
    }
    if (is_method("ACK")) {
      route(NATMANAGE);
    }
    route(RELAY);
  }
  if (is_method("ACK")) {
    if (t_check_trans()) {
      route(RELAY);
    }
    exit;
  }
  sl_send_reply("404", "Not Here");
  exit;
}

route[NATMANAGE] {
  if (is_request()) {
    if (has_totag()) {
      if (check_route_param("nat=yes")) {
        setbflag(FLB_NATB);
      }
    }
  }
  if (!(isflagset(FLT_NATS) || isbflagset(FLB_NATB))) {
    return;
  }
  if (is_request()) {
    if (!has_totag()) {
      if (t_is_branch_route()) {
        add_rr_param(";nat=yes");
      }
    }
  }
  if (is_reply()) {
    if (isbflagset(FLB_NATB)) {
      if (is_first_hop()) {
        set_contact_alias();
      }
    }
  }
}

branch_route[MANAGE_BRANCH] {
  route(NATMANAGE);
}

onreply_route[MANAGE_REPLY] {
  if (status =~ "[12][0-9][0-9]") {
    route(NATMANAGE);
  }
}

event_route[xhttp:request] {
  if ($Rp != 5071 || $si != "127.0.0.1") {
    xhttp_reply("403", "Forbidden", "", "");
    exit;
  }
  if ($hu =~ "^/RPC") {
    jsonrpc_dispatch();
  } else {
    xhttp_reply("404", "Not Found", "", "");
  }
  exit;
}
